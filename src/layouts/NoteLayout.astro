---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  summary: string;
  slug: string;
  tags?: string[];
}
const { title, date, summary, slug, tags } = Astro.props;
const iso = date.toISOString();
const isoDate = iso.slice(0, 10);

/* ---- purely decorative margin line art, seeded by slug (build-time) ---- */
function hashSeed(s: string) {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619) >>> 0;
  }
  return h;
}
function mulberry32(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (s + 0x6d2b79f5) >>> 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const ART_W = 320;
const ART_H = 940;
const STEP = 6;
const rng = mulberry32(hashSeed(slug));

/* a loosely braided bundle of smooth vertical curves: each line follows a
   few shared low-frequency modes (so the bundle weaves together) plus its
   own gentle phase drift */
const N_LINES = 14;
const modes = Array.from({ length: 3 }, (_, k) => ({
  amp: (34 - k * 9) * (0.7 + rng() * 0.6),
  freq: ((k + 1) * (1.6 + rng() * 0.9) * Math.PI * 2) / ART_H,
  phase: rng() * Math.PI * 2,
}));
const traces = Array.from({ length: N_LINES }, (_, i) => {
  const center = 46 + ((i + 0.5) / N_LINES) * (ART_W - 92);
  const drift = (rng() - 0.5) * 1.6;
  const wobbleAmp = 5 + rng() * 8;
  const wobbleFreq = ((2.5 + rng() * 2.5) * Math.PI * 2) / ART_H;
  const wobblePhase = rng() * Math.PI * 2;
  const pts: string[] = [];
  for (let y = 0; y <= ART_H; y += STEP) {
    let x = center + drift * ((y / ART_H) * 2 - 1) * 40;
    for (const m of modes) {
      x += m.amp * Math.sin(y * m.freq + m.phase + i * 0.35);
    }
    x += wobbleAmp * Math.sin(y * wobbleFreq + wobblePhase);
    pts.push(`${x.toFixed(1)},${y}`);
  }
  return pts.join(' ');
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: iso,
  author: {
    '@type': 'Person',
    name: 'Marco Biroli',
    url: 'https://marcobiroli.github.io',
  },
  keywords: tags ?? [],
  mainEntityOfPage: `https://marcobiroli.github.io/notes/${slug}`,
};
---
<BaseLayout
  title={`${title} — Marco Biroli`}
  description={summary}
  jsonLd={jsonLd}
  ogType="article"
  publishedTime={iso}
  mdAlternate={`/notes/${slug}.md`}
  keywords={tags}
>
  <div class="note-wrap">
    <article class="article">
      <div class="kicker">
        <time datetime={isoDate}>{isoDate}</time>
      </div>
      <h1>{title}</h1>
      <p class="dek">{summary}</p>
      <hr />
      <slot />
      <div class="post-nav">
        <a href="/notes">← all notes</a>
        &nbsp;·&nbsp;
        <a href={`/notes/${slug}.md`}>view as markdown</a>
      </div>
    </article>
    <aside class="margin-art" aria-hidden="true">
      <div class="inner">
        <svg
          viewBox={`0 0 ${ART_W} ${ART_H}`}
          preserveAspectRatio="xMidYMin slice"
          xmlns="http://www.w3.org/2000/svg"
        >
          {traces.map((pts) => (
            <polyline points={pts} class="trace" />
          ))}
        </svg>
      </div>
    </aside>
  </div>
</BaseLayout>
